import Mathlib

/-!
# D4 sites with tetrahedral shifts decompose into cosets

Let `G` be an additive site group and let `gens` be the allowed kinetic shifts.
This module proves that graph reachability using either orientation of `gens` is
exactly membership in the subgroup generated by `gens`.  Consequently the
connected components are the cosets `G / closure gens`.

For the intended application, `G` is the `D4` lattice and the generated
subgroup is the active tetrahedral lattice `L_H`.  If the separate lattice
theorem supplies `D4 / L_H ~= (Z/2)^3`, the kinetic graph has exactly eight
disconnected components.

The final result is deliberately conditional: this module proves the graph and
quotient theorem, not the concrete `D4 / L_H` isomorphism.  It was recovered
from Aristotle project `da0e89ee-5624-473f-836b-5787d3e8c858` and verified
under the pinned toolchain.
-/

namespace PhysicsSM.Draft.NullEdge.GateC1.D4DisconnectedCopy

variable {G : Type*} [AddCommGroup G]

/-- A graph edge changes a site by an allowed shift in either orientation. -/
def AdjStep (gens : Set G) (x y : G) : Prop :=
  y - x ∈ gens ∨ x - y ∈ gens

lemma adjStep_symm {gens : Set G} {x y : G} (hxy : AdjStep gens x y) :
    AdjStep gens y x := by
  cases hxy <;> simp_all +decide [AdjStep]

/-- Reflexive-transitive reachability in the kinetic graph. -/
def Reach (gens : Set G) : G → G → Prop :=
  Relation.ReflTransGen (AdjStep gens)

lemma reach_refl (gens : Set G) (x : G) : Reach gens x x :=
  Relation.ReflTransGen.refl

lemma reach_trans {gens : Set G} {x y z : G}
    (hxy : Reach gens x y) (hyz : Reach gens y z) : Reach gens x z :=
  hxy.trans hyz

lemma reach_symm {gens : Set G} {x y : G} (hxy : Reach gens x y) :
    Reach gens y x := by
  induction hxy
  · exact Relation.ReflTransGen.refl
  · rename_i h₁ h₂ ih
    exact ih.head (adjStep_symm h₂)

/-- Two sites are reachable exactly when their difference lies in the subgroup
generated by the allowed shifts. -/
theorem reach_iff_sub_mem_closure {gens : Set G} {x y : G} :
    Reach gens x y ↔ y - x ∈ AddSubgroup.closure gens := by
  constructor
  · intro hxy
    induction hxy
    · simp
    · rename_i h₁ h₂ ih
      rcases h₂ with h₂ | h₂
      · simpa using AddSubgroup.add_mem _ (AddSubgroup.subset_closure h₂) ih
      · simpa using AddSubgroup.sub_mem _ ih (AddSubgroup.subset_closure h₂)
  · intro hxy
    have hseq :
        ∃ l : List G,
          (∀ g ∈ l, g ∈ gens ∨ -g ∈ gens) ∧ y - x = l.sum := by
      refine AddSubgroup.closure_induction (fun g hg => ?_) ?_ ?_ ?_ hxy
      · exact ⟨[g], by simp [hg]⟩
      · exact ⟨[], by simp⟩
      · rintro a b ha hb ⟨la, hla, rfl⟩ ⟨lb, hlb, rfl⟩
        exact ⟨la ++ lb, by aesop⟩
      · rintro a ha ⟨l, hl, rfl⟩
        refine ⟨l.map (-·), ?_⟩
        constructor
        · intro g hg
          simp only [List.mem_map] at hg
          obtain ⟨a, ha, rfl⟩ := hg
          specialize hl a ha
          aesop
        · simp [List.sum_neg]
    obtain ⟨l, hl, hsum⟩ := hseq
    have hpath :
        ∀ (l : List G),
          (∀ g ∈ l, g ∈ gens ∨ -g ∈ gens) →
          ∀ x : G, Reach gens x (x + l.sum) := by
      intro l hmem x
      induction l generalizing x with
      | nil =>
          simpa using reach_refl gens x
      | cons g l ih =>
          simp only [List.sum_cons]
          have hg := hmem g (by simp)
          have htail : ∀ a ∈ l, a ∈ gens ∨ -a ∈ gens := by
            intro a ha
            exact hmem a (by simp [ha])
          have hstep : AdjStep gens x (x + g) := by
            rcases hg with hg | hg
            · left
              simpa using hg
            · right
              simpa using hg
          convert (Relation.ReflTransGen.single hstep).trans
            (ih htail (x + g)) using 1 <;> simp [add_assoc]
    simpa [← hsum] using hpath l hl x

/-- Every kinetic path preserves the quotient coset. -/
theorem reach_preserves_coset {gens : Set G} {x y : G}
    (hxy : Reach gens x y) :
    QuotientAddGroup.mk' (AddSubgroup.closure gens) x =
      QuotientAddGroup.mk' (AddSubgroup.closure gens) y := by
  rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.mk'_apply,
    QuotientAddGroup.eq]
  simpa [neg_add_eq_sub] using reach_iff_sub_mem_closure.mp hxy

/-- Sites in the same quotient coset are kinetically reachable. -/
theorem same_coset_reachable {gens : Set G} {x y : G}
    (hxy :
      QuotientAddGroup.mk' (AddSubgroup.closure gens) x =
        QuotientAddGroup.mk' (AddSubgroup.closure gens) y) :
    Reach gens x y := by
  apply reach_iff_sub_mem_closure.mpr
  rw [← QuotientAddGroup.eq_zero_iff]
  have hzero := congrArg
    (fun z => z - QuotientAddGroup.mk' (AddSubgroup.closure gens) x) hxy
  simpa using hzero.symm

/-- The reachability equivalence relation. -/
def reachSetoid (gens : Set G) : Setoid G where
  r := Reach gens
  iseqv := ⟨reach_refl gens, reach_symm, reach_trans⟩

/-- Connected components are exactly cosets of the generated subgroup. -/
theorem componentEquiv (gens : Set G) :
    Nonempty (Quotient (reachSetoid gens) ≃
      G ⧸ AddSubgroup.closure gens) := by
  refine ⟨Equiv.ofBijective ?f ⟨?inj, ?surj⟩⟩
  case f =>
    exact Quotient.lift
      (fun x => QuotientAddGroup.mk' (AddSubgroup.closure gens) x)
      (fun _ _ hxy => reach_preserves_coset hxy)
  case inj =>
    intro x y hxy
    obtain ⟨a, rfl⟩ := Quotient.exists_rep x
    obtain ⟨b, rfl⟩ := Quotient.exists_rep y
    exact Quotient.sound (same_coset_reachable hxy)
  case surj =>
    intro x
    obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective x
    exact ⟨Quotient.mk (reachSetoid gens) a, rfl⟩

/-- If the quotient is `(Z/2)^3`, the kinetic graph has exactly eight connected
components.  For `G = D4`, the concrete quotient isomorphism is a separate
lattice theorem. -/
theorem eightCopies {gens : Set G}
    (hiso : (G ⧸ AddSubgroup.closure gens) ≃+ (Fin 3 → ZMod 2)) :
    Nat.card (Quotient (reachSetoid gens)) = 8 := by
  obtain ⟨e⟩ := componentEquiv gens
  rw [Nat.card_congr e, Nat.card_congr hiso.toEquiv]
  simp

/-- The quotient hypothesis of `eightCopies` has a nonempty finite target. -/
example : Nat.card (Fin 3 → ZMod 2) = 8 := by
  simp

/-- info: 'PhysicsSM.Draft.NullEdge.GateC1.D4DisconnectedCopy.reach_iff_sub_mem_closure' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms PhysicsSM.Draft.NullEdge.GateC1.D4DisconnectedCopy.reach_iff_sub_mem_closure

/-- info: 'PhysicsSM.Draft.NullEdge.GateC1.D4DisconnectedCopy.eightCopies' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms PhysicsSM.Draft.NullEdge.GateC1.D4DisconnectedCopy.eightCopies

end PhysicsSM.Draft.NullEdge.GateC1.D4DisconnectedCopy
