#guard_msgs (whitespace := lax) in
#print axioms hasDerivAt_coframeVolume_eq_inverseMetricPairing

/-- info: 'PhysicsSM.Draft.NullEdge.CoframeVolumeMetricVariation.inverseMetricVariationLinear_isFull' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms inverseMetricVariationLinear_isFull

end PhysicsSM.Draft.NullEdge.CoframeVolumeMetricVariation
