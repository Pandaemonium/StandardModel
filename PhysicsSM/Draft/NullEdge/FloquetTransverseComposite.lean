#guard_msgs (whitespace := lax) in
#print axioms selector_isHermitian

/-- info: 'PhysicsSM.Draft.NullEdge.FloquetTransverseComposite.selector_idempotent' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms selector_idempotent

/-- info: 'PhysicsSM.Draft.NullEdge.FloquetTransverseComposite.controlled_isUnitary' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms controlled_isUnitary

/-- info: 'PhysicsSM.Draft.NullEdge.FloquetTransverseComposite.controlled_restriction' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms controlled_restriction

end

end PhysicsSM.Draft.NullEdge.FloquetTransverseComposite
