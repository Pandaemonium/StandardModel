theorem correctedEliminationCertificate (tx ty tz : Real) :
    (1 + tz ^ 2) ^ 2 * tz * certRootPoly tx ty tz *
        certExcludedPoly tx ty tz =
      certQx tx ty tz * certFx tx ty tz +
      certQy tx ty tz * certFy tx ty tz +
      certQz tx ty tz * certFz tx ty tz := by
  unfold certQx certQy certQz certFx certFy certFz
  unfold certRootPoly certExcludedPoly
  ring

theorem eliminationFactorNecessaryOfNumeratorsZero (tx ty tz : Real)
    (hx : certFx tx ty tz = 0)
    (hy : certFy tx ty tz = 0)
    (hz : certFz tx ty tz = 0) :
    Or (tz = 0) (Or (certRootPoly tx ty tz = 0)
      (certExcludedPoly tx ty tz = 0)) := by
  have hcert := correctedEliminationCertificate tx ty tz
  rw [hx, hy, hz] at hcert
  simp only [mul_zero, add_zero, zero_add] at hcert
  have hchart : Not ((1 + tz ^ 2) ^ 2 = 0) := by positivity
  have hrest :
      (1 + tz ^ 2) ^ 2 *
        (tz * certRootPoly tx ty tz * certExcludedPoly tx ty tz) = 0 := by
    simpa only [mul_assoc] using hcert
  have hproduct :
      tz * certRootPoly tx ty tz * certExcludedPoly tx ty tz = 0 :=
    (mul_eq_zero.mp hrest).resolve_left hchart
  exact Or.elim (mul_eq_zero.mp hproduct)
    (fun hleft => Or.elim (mul_eq_zero.mp hleft)
      (fun htz => Or.inl htz)
      (fun hroot => Or.inr (Or.inl hroot)))
    (fun hexcluded => Or.inr (Or.inr hexcluded))

end

