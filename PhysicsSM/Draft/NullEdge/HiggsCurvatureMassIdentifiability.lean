#guard_msgs (whitespace := lax) in
#print axioms constantCurvature_nontrivial_propagator_degeneracy

/-- info: 'PhysicsSM.Draft.NullEdge.HiggsCurvatureMassIdentifiability.twoVertices_identify_parameters' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms twoVertices_identify_parameters

end PhysicsSM.Draft.NullEdge.HiggsCurvatureMassIdentifiability

end
