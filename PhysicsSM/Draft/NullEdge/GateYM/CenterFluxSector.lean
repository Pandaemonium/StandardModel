namespace PhysicsSM
namespace Draft
namespace NullEdge
namespace GateYM
namespace CenterFluxSector

/-- A family of flux-shift permutations of a finite configuration space.

For the intended Yang-Mills instance, `Shift` will be generated by central
flux insertions along the two fundamental cycles of a torus. -/
structure ShiftSystem (Config Shift : Type*) where
  shift : Shift -> Equiv.Perm Config

namespace ShiftSystem

variable {Config Shift : Type*}

/-- Apply one flux shift to a configuration. -/
def shiftConfig (S : ShiftSystem Config Shift) (z : Shift) (x : Config) : Config :=
  S.shift z x

/-- The induced shift operator on wavefunctions. -/
def shiftOp (S : ShiftSystem Config Shift) (z : Shift)
    (psi : Config -> Complex) : Config -> Complex :=
  fun x => psi (S.shiftConfig z x)

/-- An electric-flux sector is an eigenspace for every flux shift.

The function `character` records the eigenvalue for each shift.  In the
concrete center-flux instance it should come from a character of the finite
center-shift group; this abstract file does not need the group law. -/
def InElectricSector (S : ShiftSystem Config Shift)
    (character : Shift -> Complex) (psi : Config -> Complex) : Prop :=
  forall z x, psi (S.shiftConfig z x) = character z * psi x

/-- A diagonal observable is shift-invariant when it is constant along all
flux-shift orbits.  Local plaquette holonomy functions are expected to be
instances in the concrete center-shift layer. -/
def ShiftInvariantObservable (S : ShiftSystem Config Shift)
    (O : Config -> Complex) : Prop :=
  forall z x, O (S.shiftConfig z x) = O x

/-- Multiplication by a diagonal observable. -/
def multiplyObservable (O psi : Config -> Complex) : Config -> Complex :=
  fun x => O x * psi x

/-- Shift-invariant diagonal observables preserve every electric-flux
sector. -/
theorem inElectricSector_multiplyObservable
    (S : ShiftSystem Config Shift) (character : Shift -> Complex)
    (O psi : Config -> Complex)
    (hO : ShiftInvariantObservable S O)
    (hpsi : InElectricSector S character psi) :
    InElectricSector S character (multiplyObservable O psi) := by
  intro z x
  unfold multiplyObservable
  rw [hO z x, hpsi z x]
  ring

/-- A finite transfer kernel acts by summing over the source configuration.

The convention is `K x y`: amplitude from source `y` to target `x`. -/
def applyKernel [Fintype Config] (K : Config -> Config -> Complex)
    (psi : Config -> Complex) : Config -> Complex :=
  fun x => ∑ y : Config, K x y * psi y

/-- A kernel is invariant under simultaneous flux shifts of source and
target configurations.  This is the finite-kernel commutation condition that
implies preservation of electric sectors. -/
def KernelInvariantUnderShifts (S : ShiftSystem Config Shift)
    (K : Config -> Config -> Complex) : Prop :=
  forall z x y, K (S.shiftConfig z x) (S.shiftConfig z y) = K x y

/-- A finite kernel invariant under flux shifts preserves every electric
sector. -/
theorem inElectricSector_applyKernel [Fintype Config]
    (S : ShiftSystem Config Shift) (K : Config -> Config -> Complex)
    (character : Shift -> Complex) (psi : Config -> Complex)
    (hK : KernelInvariantUnderShifts S K)
    (hpsi : InElectricSector S character psi) :
    InElectricSector S character (applyKernel K psi) := by
  intro z x
  unfold applyKernel
  calc
    (∑ y : Config, K (S.shiftConfig z x) y * psi y)
        = ∑ y : Config,
            K (S.shiftConfig z x) (S.shiftConfig z y) *
              psi (S.shiftConfig z y) := by
          simpa [shiftConfig] using
            (Equiv.sum_comp (S.shift z)
              (fun y : Config => K (S.shiftConfig z x) y * psi y)).symm
    _ = ∑ y : Config, K x y * (character z * psi y) := by
          apply Finset.sum_congr rfl
          intro y _hy
          rw [hK z x y, hpsi z y]
    _ = character z * ∑ y : Config, K x y * psi y := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro y _hy
          ring

end ShiftSystem

