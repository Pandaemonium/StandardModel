import PhysicsSM.Draft.NullEdge.VariablePlueckerLocalWalk

/-!
# Explicit temporal blocking and nonclosure of the split-step family

Two-step temporal blocking is the exact map `U -> U*U`.  The mass-only
Pluecker subgroup closes under this map by the exact coin group law.  The
ordered multi-axis split family does not close by naïvely doubling its step
parameter: at the exact `pi/2` x-y witness, the blocked step is `-I` while the
doubled-parameter step is `+I`.

The canonical smallest multiplicatively closed enlargement is the submonoid
generated by all bare split steps.  This identifies precisely what blocking
adds: ordered products (new word/coupling data), not merely a renormalized
copy of the original five scalar parameters.  It is a temporal blocking
theorem, not yet a spatial decimation or thermodynamic RG calculation.

Provenance: clean-room composition of the exact Pluecker coin group law and
the live ordered `3+1` split step.  Lean 4.28.0.
-/

noncomputable section

open Matrix Complex

namespace PhysicsSM.Draft.NullEdge.TemporalBlockingRG

open PhysicsSM.Draft.NullEdge.Compact3Plus1DiracRate

abbrev Mat4 := Matrix (Fin 4) (Fin 4) Complex

/-- Exact two-step temporal blocking. -/
def block2 (U : Mat4) : Mat4 := U * U

/-- The Pluecker mass-only subgroup closes under two-step blocking. -/
theorem massCoin4_block2_closes (z : Complex) (eps : Real) :
    block2 (Pluecker3Plus1ComplexMass.massCoin4 z eps) =
      Pluecker3Plus1ComplexMass.massCoin4 z (2 * eps) := by
  unfold block2
  rw [VariablePlueckerLocalWalk.massCoin4_group_total]
  congr 1
  ring

structure StepParameters where
  kx : Real
  ky : Real
  kz : Real
  m : Real
  eps : Real

def bareStep (p : StepParameters) : Mat4 :=
  splitStep p.kx p.ky p.kz p.m p.eps

def bareFamily : Set Mat4 := Set.range bareStep

/-- Smallest exact multiplicatively closed enlargement of the bare family. -/
def blockedFamily : Submonoid Mat4 := Submonoid.closure bareFamily

theorem bare_mem_blocked (p : StepParameters) : bareStep p ∈ blockedFamily := by
  exact Submonoid.subset_closure ⟨p, rfl⟩

theorem blocked_mul_closed (U V : Mat4)
    (hU : U ∈ blockedFamily) (hV : V ∈ blockedFamily) :
    U * V ∈ blockedFamily := by
  exact mul_mem hU hV

/-- Minimality: every submonoid containing the bare split steps contains the
whole blocked family. -/
theorem blockedFamily_le_of_bare_le (S : Submonoid Mat4)
    (h : ∀ p, bareStep p ∈ S) :
    blockedFamily ≤ S := by
  apply Submonoid.closure_le.mpr
  rintro U ⟨p, rfl⟩
  exact h p

def xyQuarter : StepParameters where
  kx := 1
  ky := 1
  kz := 0
  m := 0
  eps := Real.pi / 2

def xyHalf : StepParameters where
  kx := 1
  ky := 1
  kz := 0
  m := 0
  eps := Real.pi

/-- Exact nonclosure witness: blocking the ordered x-y quarter-turn produces
`-I`, whereas doubling the scalar step parameter produces `+I`. -/
theorem xy_blocking_nonclosure_control :
    block2 (bareStep xyQuarter) = -(1 : Mat4) ∧
      bareStep xyHalf = 1 ∧
      block2 (bareStep xyQuarter) ≠ bareStep xyHalf := by
  have h12 : (alpha1 * alpha2) * (alpha1 * alpha2) = -(1 : Mat4) := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [alpha1, alpha2, Matrix.mul_apply, Fin.sum_univ_succ]
  have hquarter : bareStep xyQuarter = -(alpha1 * alpha2) := by
    unfold bareStep xyQuarter splitStep factor
    simp
    simp [smul_smul]
  have hblock : block2 (bareStep xyQuarter) = -(1 : Mat4) := by
    rw [hquarter]
    unfold block2
    simpa using h12
  have hdouble : bareStep xyHalf = (1 : Mat4) := by
    unfold bareStep xyHalf splitStep factor
    simp
  refine ⟨hblock, hdouble, ?_⟩
  rw [hblock, hdouble]
  intro h
  have h00 := congrFun (congrFun h 0) 0
  norm_num at h00

/-! ## Build-enforced assumption-footprint guards -/

/-- info: 'PhysicsSM.Draft.NullEdge.TemporalBlockingRG.massCoin4_block2_closes' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms massCoin4_block2_closes

/-- info: 'PhysicsSM.Draft.NullEdge.TemporalBlockingRG.xy_blocking_nonclosure_control' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms xy_blocking_nonclosure_control

end PhysicsSM.Draft.NullEdge.TemporalBlockingRG
