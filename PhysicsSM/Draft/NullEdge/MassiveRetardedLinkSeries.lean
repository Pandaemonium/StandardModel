#guard_msgs (whitespace := lax) in
#print axioms one_add_mass_kernel_mul_series

/-- info: 'PhysicsSM.Draft.NullEdge.MassiveRetardedLinkSeries.threeLink_massive_multiedge_witness' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms threeLink_massive_multiedge_witness

end PhysicsSM.Draft.NullEdge.MassiveRetardedLinkSeries

end
