/-- The core polynomial matrix identity: with the specific rational tangent coordinates and
`rootPoly t = 0`, the cleared numerator product equals a scalar multiple of the identity. -/
theorem core (t : ℝ) (ht : rootPoly t = 0) :
    fN (tangentX t) Px * fN (tangentX t) Qx * (fN (tangentY t) Py * fN (tangentY t) Qy)
      * (fN t Pz * fN t Qz)
      = (sScal (tangentX t) * sScal (tangentY t) * sScal t) • (1 : M2) := by
  refine coreGen (tangentX t) (tangentY t) t ht ?_ ?_
  · rw [tangentX]; field_simp
  · rw [tangentY]; field_simp

theorem exact_alias_of_root {t : ℝ}
    (ht : rootPoly t = 0) :
    weylStep (unitPhase (tangentX t)) (unitPhase (tangentY t))
      (unitPhase t) = 1 := by
  unfold weylStep
  rw [walkN, walkN, walkN]
  simp only [Matrix.smul_mul, Matrix.mul_smul, smul_smul]
  rw [core t ht, smul_smul, smul_one_eq_one_iff]
  simp only [sScal_eq]
  field_simp [unitPhase_ne_zero, da_ne]
  exact div_self (mul_ne_zero (mul_ne_zero (da_ne t) (da_ne (tangentY t))) (da_ne (tangentX t)))

theorem exists_exact_fully_offaxis_alias :
    ∃ tx ty tz : ℝ,
      tx ≠ 0 ∧ ty ≠ 0 ∧ tz ≠ 0 ∧
      starRingEnd ℂ (unitPhase tx) * unitPhase tx = 1 ∧
      starRingEnd ℂ (unitPhase ty) * unitPhase ty = 1 ∧
      starRingEnd ℂ (unitPhase tz) * unitPhase tz = 1 ∧
      unitPhase tx ≠ 1 ∧ unitPhase ty ≠ 1 ∧ unitPhase tz ≠ 1 ∧
      weylStep (unitPhase tx) (unitPhase ty) (unitPhase tz) = 1 := by
  obtain ⟨t, hlow, hhigh, hroot⟩ := exists_rootPoly_in_interval
  obtain ⟨hx, hy, ht⟩ := tangent_coordinates_nonzero hlow hhigh
  exact ⟨tangentX t, tangentY t, t, hx, hy, ht,
    unitPhase_on_circle _, unitPhase_on_circle _, unitPhase_on_circle _,
    unitPhase_ne_one_of_ne_zero hx, unitPhase_ne_one_of_ne_zero hy,
    unitPhase_ne_one_of_ne_zero ht, exact_alias_of_root hroot⟩

