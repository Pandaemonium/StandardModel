import PhysicsSM.Draft.NullEdge.StationaryAmplitudeWeylTangent
import PhysicsSM.Draft.NullEdge.StationaryAmplitudeWeylRootClassification

/-!
# Exact algebraic fully off-axis stationary-Weyl crossing

The tangent-half-angle elimination reconstructs an exact identity crossing of
the live stationary-amplitude Weyl matrix from a real root of one integer
quintic. A rational isolating interval supplies a root and proves that all
three tangent coordinates are nonzero. The reconstructed phases are therefore
unit-modulus, different from one on all three axes, and the actual imported
`StationaryAmplitudeWeylTangent.weylStep` is exactly the identity.

This is one exact crossing, not a complete Brillouin-zone census. The global
real-root count is proved separately in
`StationaryAmplitudeWeylRootClassification`; the full elimination converse
and chart-boundary census remain separate gates.

Provenance: theorem statements prepared from the exact SymPy elimination in
`Scripts/oracle/analyze_stationary_amplitude_weyl.py`. Proofs returned by
Aristotle project `5c45a7f6-98de-4974-9feb-4b5acee6a208`, task
`f61cb46d-360a-4e61-af96-c676001bd83e`, then adapted to the imported live
matrix definitions and independently rebuilt under Lean 4.28.0.
-/

noncomputable section

open Matrix Complex Real Set

namespace PhysicsSM.Draft.NullEdge.StationaryAmplitudeWeylAlgebraicOffAxisAlias

open StationaryAmplitudeWeylTangent
open StationaryAmplitudeProjectorWalk

abbrev M2 := StationaryAmplitudeWeylTangent.M2

def rootPoly (t : ℝ) : ℝ :=
  480 * t ^ 5 - 575 * t ^ 4 - 1026 * t ^ 2 + 1440 * t - 575

/-- The polynomial used by the matrix reconstruction is definitionally the
factor whose unique real root was classified independently. -/
theorem rootPoly_eq_classification (t : ℝ) :
    rootPoly t = StationaryAmplitudeWeylRootClassification.rootPoly t := by
  rfl

/-- The matrix-reconstruction quintic has exactly one real root globally. -/
theorem rootPoly_existsUnique_real :
    ∃! t : ℝ, rootPoly t = 0 := by
  simpa [rootPoly, StationaryAmplitudeWeylRootClassification.rootPoly] using
    StationaryAmplitudeWeylRootClassification.rootPoly_existsUnique_real

def tangentX (t : ℝ) : ℝ :=
  (1061280 * t ^ 4 - 462525 * t ^ 3 - 644875 * t ^ 2 -
    2634243 * t + 1258155) / 430976

def tangentY (t : ℝ) : ℝ :=
  (574560 * t ^ 4 - 959475 * t ^ 3 - 575125 * t ^ 2 -
    958797 * t + 2176245) / 820352

def unitPhase (t : ℝ) : ℂ :=
  (((1 - t ^ 2) / (1 + t ^ 2) : ℝ) : ℂ) +
    I * (((2 * t) / (1 + t ^ 2) : ℝ) : ℂ)

theorem rootPoly_at_lower : rootPoly (149 / 100) < 0 := by
  unfold rootPoly; norm_num

theorem rootPoly_at_upper : 0 < rootPoly (3 / 2) := by
  unfold rootPoly; norm_num

theorem exists_rootPoly_in_interval :
    ∃ t : ℝ, 149 / 100 < t ∧ t < 3 / 2 ∧ rootPoly t = 0 := by
  have hcont : ContinuousOn rootPoly (Icc (149 / 100) (3 / 2)) := by
    unfold rootPoly; fun_prop
  have hlt : (149 : ℝ) / 100 < 3 / 2 := by norm_num
  have h := intermediate_value_Ioo (le_of_lt hlt) hcont
  have h0 : (0 : ℝ) ∈ Ioo (rootPoly (149 / 100)) (rootPoly (3 / 2)) :=
    ⟨rootPoly_at_lower, rootPoly_at_upper⟩
  obtain ⟨t, ht, hval⟩ := h h0
  exact ⟨t, ht.1, ht.2, hval⟩

theorem unitPhase_on_circle (t : ℝ) :
    starRingEnd ℂ (unitPhase t) * unitPhase t = 1 := by
  have hpos : (1 + t ^ 2) ≠ 0 := by positivity
  have hreal : ((1 - t ^ 2) / (1 + t ^ 2) : ℝ) ^ 2
      + ((2 * t) / (1 + t ^ 2) : ℝ) ^ 2 = 1 := by
    field_simp; ring
  have hc : (((1 - t ^ 2) / (1 + t ^ 2) : ℝ) : ℂ) ^ 2
      + (((2 * t) / (1 + t ^ 2) : ℝ) : ℂ) ^ 2 = 1 := by
    rw [← Complex.ofReal_pow, ← Complex.ofReal_pow, ← Complex.ofReal_add, hreal]; norm_num
  unfold unitPhase
  simp only [map_add, map_mul, Complex.conj_ofReal, Complex.conj_I]
  linear_combination hc - (((2 * t) / (1 + t ^ 2) : ℝ) : ℂ) ^ 2 * Complex.I_sq

theorem tangent_coordinates_nonzero {t : ℝ}
    (hlow : 149 / 100 < t) (hhigh : t < 3 / 2) :
    tangentX t ≠ 0 ∧ tangentY t ≠ 0 ∧ t ≠ 0 := by
  refine ⟨?_, ?_, ?_⟩
  · have hx : 1061280 * t ^ 4 - 462525 * t ^ 3 - 644875 * t ^ 2
        - 2634243 * t + 1258155 < 0 := by
      nlinarith [mul_pos (sub_pos.2 hlow) (sub_pos.2 hhigh), hlow, hhigh,
        sq_nonneg (t - 149 / 100), sq_nonneg (3 / 2 - t)]
    unfold tangentX
    exact div_ne_zero (ne_of_lt hx) (by norm_num)
  · have hy : 574560 * t ^ 4 - 959475 * t ^ 3 - 575125 * t ^ 2
        - 958797 * t + 2176245 < 0 := by
      nlinarith [mul_pos (sub_pos.2 hlow) (sub_pos.2 hhigh), hlow, hhigh,
        sq_nonneg (t - 149 / 100), sq_nonneg (3 / 2 - t)]
    unfold tangentY
    exact div_ne_zero (ne_of_lt hy) (by norm_num)
  · linarith

theorem unitPhase_ne_one_of_ne_zero {t : ℝ} (ht : t ≠ 0) :
    unitPhase t ≠ 1 := by
  intro h
  have him : (unitPhase t).im = (1 : ℂ).im := by rw [h]
  simp only [unitPhase, Complex.add_im, Complex.ofReal_im, Complex.mul_im,
    Complex.I_re, Complex.I_im, Complex.ofReal_re, Complex.one_im] at him
  have hpos : (1 + t ^ 2) > 0 := by positivity
  have hz : (2 * t / (1 + t ^ 2)) = 0 := by linarith
  rw [div_eq_zero_iff] at hz
  rcases hz with h1 | h2
  · exact ht (by linarith [h1])
  · linarith

/-! ### Reduction of the Weyl step to a polynomial matrix identity -/

/-- `unitPhase` never vanishes (it lies on the unit circle). -/
theorem unitPhase_ne_zero (s : ℝ) : unitPhase s ≠ 0 := by
  intro h
  have := unitPhase_on_circle s
  rw [h] at this; simp at this

/-- The denominator `1 + s²` is a nonzero complex scalar. -/
theorem da_ne (s : ℝ) : ((1 + s ^ 2 : ℝ) : ℂ) ≠ 0 := by
  have : (1 + s ^ 2 : ℝ) ≠ 0 := by positivity
  exact_mod_cast this

/-- Cleared "numerator" version of a forward phase: `(1+s²) • forwardPhase (unitPhase s) P`. -/
def fN (s : ℝ) (P : M2) : M2 :=
  ((((1 - s ^ 2) : ℝ) : ℂ) + I * (((2 * s) : ℝ) : ℂ)) • P
    + (((1 + s ^ 2 : ℝ) : ℂ)) • (1 - P)

/-- Cleared "numerator" scalar `(1+s²) • unitPhase s` times `(1+s²)`. -/
def sScal (s : ℝ) : ℂ :=
  ((1 + s ^ 2 : ℝ) : ℂ) * ((((1 - s ^ 2) : ℝ) : ℂ) + I * (((2 * s) : ℝ) : ℂ))

theorem backward_eq {z : ℂ} (hz : z ≠ 0) (Q : M2) :
    backwardPhase z Q = z⁻¹ • forwardPhase z Q := by
  unfold backwardPhase forwardPhase
  rw [smul_add, smul_smul, inv_mul_cancel₀ hz, one_smul]

theorem walk_eq {z : ℂ} (hz : z ≠ 0) (P Q : M2) :
    stationaryWalk z P Q = z⁻¹ • (forwardPhase z P * forwardPhase z Q) := by
  unfold stationaryWalk
  rw [backward_eq hz, Matrix.mul_smul]

theorem fN_eq (s : ℝ) (P : M2) :
    (((1 + s ^ 2 : ℝ) : ℂ)) • forwardPhase (unitPhase s) P = fN s P := by
  have hpos : ((1 + s ^ 2 : ℝ) : ℂ) ≠ 0 := da_ne s
  unfold forwardPhase complement fN unitPhase
  rw [smul_add, smul_smul]
  congr 2
  rw [Complex.ofReal_div, Complex.ofReal_div]
  field_simp

theorem sScal_eq (s : ℝ) :
    sScal s = ((1 + s ^ 2 : ℝ) : ℂ) ^ 2 * unitPhase s := by
  unfold sScal unitPhase
  rw [Complex.ofReal_div, Complex.ofReal_div]
  field_simp

theorem fwd_eq (s : ℝ) (P : M2) :
    forwardPhase (unitPhase s) P = (((1 + s ^ 2 : ℝ) : ℂ))⁻¹ • fN s P := by
  rw [← fN_eq, smul_smul, inv_mul_cancel₀ (da_ne s), one_smul]

theorem walkN (s : ℝ) (P Q : M2) :
    stationaryWalk (unitPhase s) P Q
      = ((unitPhase s)⁻¹ * (((1 + s ^ 2 : ℝ) : ℂ))⁻¹ * (((1 + s ^ 2 : ℝ) : ℂ))⁻¹)
        • (fN s P * fN s Q) := by
  rw [walk_eq (unitPhase_ne_zero s), fwd_eq, fwd_eq, Matrix.smul_mul, Matrix.mul_smul,
    smul_smul, smul_smul]

theorem scalar_cancel (s : ℝ) :
    ((unitPhase s)⁻¹ * (((1 + s ^ 2 : ℝ) : ℂ))⁻¹ * (((1 + s ^ 2 : ℝ) : ℂ))⁻¹) * sScal s = 1 := by
  rw [sScal_eq]
  field_simp [unitPhase_ne_zero s, da_ne s]
  exact mul_inv_cancel₀ (da_ne s)

theorem smul_one_eq_one_iff {c : ℂ} : c • (1 : M2) = 1 ↔ c = 1 := by
  constructor
  · intro h
    have := congrFun (congrFun h 0) 0
    simpa using this
  · rintro rfl; simp

def WaE (a : ℝ) : M2 := !![((-7*a^4/25 - 18*a^2/25 + 1 : ℝ) : ℂ) + I * ((14*a^3/25 + 2*a : ℝ) : ℂ), ((24*a^4/25 - 84*a^2/25 : ℝ) : ℂ) + I * ((-78*a^3/25 + 6*a/5 : ℝ) : ℂ); ((-24*a^4/25 - 36*a^2/25 : ℝ) : ℂ) + I * ((18*a^3/25 + 6*a/5 : ℝ) : ℂ), ((-7*a^4/25 - 18*a^2/25 + 1 : ℝ) : ℂ) + I * ((14*a^3/25 + 2*a : ℝ) : ℂ)]
def WbE (b : ℝ) : M2 := !![((-7*b^4/25 - 18*b^2/25 + 1 : ℝ) : ℂ) + I * ((14*b^3/25 + 2*b : ℝ) : ℂ), ((-78*b^3/25 + 6*b/5 : ℝ) : ℂ) + I * ((-24*b^4/25 + 84*b^2/25 : ℝ) : ℂ); ((-18*b^3/25 - 6*b/5 : ℝ) : ℂ) + I * ((-24*b^4/25 - 36*b^2/25 : ℝ) : ℂ), ((-7*b^4/25 - 18*b^2/25 + 1 : ℝ) : ℂ) + I * ((14*b^3/25 + 2*b : ℝ) : ℂ)]
def WcE (t : ℝ) : M2 := !![((-7*t^4/25 - 78*t^2/25 + 1 : ℝ) : ℂ) + I * ((-16*t^3/25 + 16*t/5 : ℝ) : ℂ), ((-24*t^4/25 + 24*t^2/25 : ℝ) : ℂ) + I * ((48*t^3/25 : ℝ) : ℂ); ((24*t^4/25 - 24*t^2/25 : ℝ) : ℂ) + I * ((-48*t^3/25 : ℝ) : ℂ), ((-7*t^4/25 + 42*t^2/25 + 1 : ℝ) : ℂ) + I * ((44*t^3/25 + 4*t/5 : ℝ) : ℂ)]

