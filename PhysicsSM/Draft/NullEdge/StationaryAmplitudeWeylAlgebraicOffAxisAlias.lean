theorem coreGen (a b t : ℝ) (ht : rootPoly t = 0)
    (ha : 430976 * a = 1061280 * t ^ 4 - 462525 * t ^ 3 - 644875 * t ^ 2 - 2634243 * t + 1258155)
    (hb : 820352 * b = 574560 * t ^ 4 - 959475 * t ^ 3 - 575125 * t ^ 2 - 958797 * t + 2176245) :
