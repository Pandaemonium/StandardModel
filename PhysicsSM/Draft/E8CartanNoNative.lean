/-- There are exactly `240` roots. -/
theorem E8Roots_length : E8Roots.length = 240 := by decide

/-- **Every E8 root has squared length `2`** (kernel-checked, no `native_decide`). -/
theorem E8Roots_sq_norm :
    ∀ r ∈ E8Roots, ∑ i, r i ^ 2 = 2 := by
  intro r hr
  fin_cases hr <;>
    simp only [Fin.sum_univ_eight, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val] <;>
    norm_num

