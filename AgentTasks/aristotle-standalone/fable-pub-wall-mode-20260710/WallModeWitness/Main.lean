/-- Site-dependent primitive spinor pair whose Pluecker coordinate is the
wall profile: psi = (1,0), phi x = (0, sign(x) * (3/5)). -/
def wallField (x : Fin 8) : Complex :=
  if x.val < 4 then (3 / 5 : Complex) else (-(3 / 5) : Complex)

def wallSpinorPsi (_ : Fin 8) : Fin 2 -> Complex := ![1, 0]

def wallSpinorPhi (x : Fin 8) : Fin 2 -> Complex := ![0, wallField x]

/-- **T5 (derived wall).**  The sign-wall profile is the spinor wedge of the
explicit pair field: the defect is a collinearity crossing, not an assigned
label. -/
theorem wallField_is_pluecker (x : Fin 8) :
    wallSpinorPsi x 0 * wallSpinorPhi x 1
      - wallSpinorPsi x 1 * wallSpinorPhi x 0 = wallField x := by
  sorry

/-- **T1 (exact +1 bound state).** -/
theorem wallWalk_modePlus :
    wallWalk.mulVec modePlus = modePlus := by
  sorry

/-- **T2 (exact -1 bound state).** -/
theorem wallWalk_modeMinus :
    wallWalk.mulVec modeMinus = (-1 : Complex) • modeMinus := by
  sorry

/-- Site probability of a two-component-per-site vector. -/
def siteProb (v : Fin 16 -> Complex) (x : Fin 8) : Real :=
  Complex.normSq (v ⟨2 * x.val, by omega⟩)
    + Complex.normSq (v ⟨2 * x.val + 1, by omega⟩)

/-- **T3 (wall localization).**  The +1 mode concentrates at the 3|4 wall:
site probability 256/5 there versus 1 at the antipodal sites. -/
theorem modePlus_localized :
    siteProb modePlus 3 = 256 / 5 ∧ siteProb modePlus 4 = 256 / 5 ∧
    siteProb modePlus 0 = 1 ∧ siteProb modePlus 7 = 1 := by
  sorry

/-- **T4 (zero-wall control).**  The constant-field walk has no exact `+1`
or `-1` mode: two-sided inverse certificates for `constWalk -+ 1`. -/
theorem constWalk_gap_certificates :
    (constWalk - 1) * certMinus = 1 ∧ certMinus * (constWalk - 1) = 1 ∧
    (constWalk + 1) * certPlus = 1 ∧ certPlus * (constWalk + 1) = 1 := by
  sorry

/-- **T4' (control corollary).**  Hence no nonzero vector satisfies
`constWalk.mulVec v = v` or `constWalk.mulVec v = -v`. -/
theorem constWalk_no_pinned_modes :
    (∀ v : Fin 16 -> Complex, constWalk.mulVec v = v -> v = 0) ∧
    (∀ v : Fin 16 -> Complex, constWalk.mulVec v = (-1 : Complex) • v -> v = 0) := by
  sorry

end WallModeWitness
