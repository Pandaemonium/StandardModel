def Qg : N28 := ofArr QgArr
def Qinvg : N28 := ofArr QinvgArr
def Dg : N28 := Matrix.diagonal dgv

set_option maxHeartbeats 2000000 in
theorem diagRaw :
    (ofArr (toArr (Qg * Qinvg)) = (1:N28)) ∧
    (ofArr (toArr (Qinvg * Qg)) = (1:N28)) ∧
    (ofArr (toArr (Qinvg * U2g * Qg)) = Dg) := by native_decide

theorem hQQ1 : Qg * Qinvg = 1 := by have h := diagRaw.1; rwa [mkEq] at h
theorem hQQ2 : Qinvg * Qg = 1 := by have h := diagRaw.2.1; rwa [mkEq] at h
theorem hconj : Qinvg * U2g * Qg = Dg := by have h := diagRaw.2.2; rwa [mkEq] at h

noncomputable def Qunit : (Matrix (Fin 28) (Fin 28) GR)ˣ := ⟨Qg, Qinvg, hQQ1, hQQ2⟩

theorem U2g_charpoly_prod :
    U2g.charpoly = ∏ i, (Polynomial.X - Polynomial.C (dgv i)) := by
  have h1 := Matrix.charpoly_units_conj' Qunit U2g
  rw [← h1]
  show (Qinvg * U2g * Qg).charpoly = _
  rw [hconj, Dg, Matrix.charpoly_diagonal]
