import Mathlib

/-!
# The generalized Pluecker rest operator: a cube law for any number of null constituents

Paper A (null-spinor area to Dirac gap) proves, for TWO spinors, that the
canonical rest operator `B_z = [[0,z],[conj z,0]]` squares to the exterior
area budget.  Its open problem 4 asks for the canonical operator built from
the FULL pairwise-area data of `n` spinors.  This file states the answer,
verified exactly by an independent oracle at `n = 2,3,4,5` before
submission.

Setup: `n` spinors `psi_i = (u i, v i)` in `C^2`.  The pairwise areas
`z_ij = u i * v j - u j * v i` assemble into the antisymmetric matrix
`Z = u v^T - v u^T` (rank <= 2), and the complete area budget is
`budget = (sum |u|^2)(sum |v|^2) - |<u,v>|^2` (a real scalar, the Gram
determinant).

The structural results:

* **Lagrange identity**: `sum_{i,j} |Z i j|^2 = 2 * budget` - the budget
  is exactly the total pairwise area, `budget = sum_{i<j} |z_ij|^2`.
* **Cube closure**: `Z * Zdag * Z = budget * Z`.  The generalized rest
  operator `B = fromBlocks 0 Z Zdag 0` is Hermitian, odd for the block
  grading, and obeys `B^3 = budget * B` - the SAME finite closure shape
  as the interaction generator's `K^3 = |z|^2 K` in the companion
  dynamics paper.  One cubic algebra governs both the rest sector and
  the supplied interaction.
* **Rank-4 support**: when `budget /= 0`, `P = budget^{-1} * B^2` is an
  idempotent with trace `4`: the rest gap `+-sqrt(budget)` lives on an
  exactly four-dimensional subspace regardless of `n`, and `B^2` equals
  `budget` times the support projector.
* **`n = 2` recovery**: the support is everything - `B^2 = budget * 1`
  on all of `C^4`, the landed two-spinor law.
* **Massless boundary**: `Z = 0 <-> budget = 0` (all pairwise areas
  vanish simultaneously - collinear null directions).
* **Load-bearing control**: the explicit non-decomposable antisymmetric
  `Z0` (two disjoint 2-blocks at `n = 4`, which is NOT generated by any
  single spinor family) has `budget = 2` but `Z0 Z0dag Z0 = Z0 /= 2 Z0`:
  the cube law is a theorem about spinor-generated (rank <= 2,
  Pluecker-decomposable) area data, not about antisymmetric matrices.

Oracle: exact sympy, generic rational-complex spinors at n = 2,3,4,5,
plus the parallel (budget = 0) degeneration and the Z0 control - all
seven law groups verified exactly, control violation confirmed with
witness entry (0,1): 1 vs 2.

Proof notes: T1/T2 are entrywise finite-sum algebra (expand
`Z = u v^T - v u^T`, collect the four Gram scalars; Lagrange-type
rearrangement).  `star budget = budget` is needed to transfer T1 across
the dagger for the B-cube law.  T5 follows formally from T4
(`B^4 = budget * B^2` gives idempotency of `P`; the trace uses
`tr(B^2) = 2 tr(Z Zdag) = 4 * budget` via T2).  T6 is a finite
computation at `n = 2`.  T8's witness is an explicit 4x4 entry check.
-/

noncomputable section

namespace PhysicsSM.Draft.NullEdge.PlueckerRestOperatorGeneral

open Matrix BigOperators

variable {n : ℕ}

/-- The pairwise-area (Pluecker) matrix of a spinor family:
`Z i j = u i * v j - u j * v i`. -/
def areaMatrix (u v : Fin n → ℂ) : Matrix (Fin n) (Fin n) ℂ :=
  Matrix.of fun i j => u i * v j - u j * v i

/-- The complete area budget: the Gram determinant
`(sum |u|^2)(sum |v|^2) - <u,v><v,u>` (real-valued, as a complex scalar). -/
def budget (u v : Fin n → ℂ) : ℂ :=
  (∑ i, star (u i) * u i) * (∑ i, star (v i) * v i)
    - (∑ i, star (u i) * v i) * (∑ i, star (v i) * u i)

/-- The budget is real. -/
theorem budget_star (u v : Fin n → ℂ) : star (budget u v) = budget u v := by
  unfold budget
  simp +decide [mul_comm]

/-- T2 (Lagrange identity): the total squared pairwise area is twice the
budget - so `budget = sum_{i<j} |z_ij|^2`. -/
theorem sum_sq_areaMatrix (u v : Fin n → ℂ) :
    ∑ i, ∑ j, star (areaMatrix u v i j) * areaMatrix u v i j
      = 2 * budget u v := by
  unfold areaMatrix budget
  simp +decide [Finset.mul_sum _ _ _, mul_assoc, mul_comm, mul_left_comm, sub_mul, mul_sub]
  simp +decide only [← mul_assoc, ← Finset.sum_comm, ← Finset.sum_mul]; ring_nf
  simp +decide only [mul_comm, Finset.mul_sum _ _ _, mul_left_comm]

/-- T1 (cube closure for the area matrix):
`Z * Zdag * Z = budget * Z`. -/
theorem areaMatrix_cube (u v : Fin n → ℂ) :
    areaMatrix u v * (areaMatrix u v)ᴴ * areaMatrix u v
      = budget u v • areaMatrix u v := by
  ext i k; simp +decide [Matrix.mul_apply, budget, Matrix.conjTranspose_apply, areaMatrix]; ring_nf
  simp +decide only [mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _]; ring_nf
  simp +decide only [mul_comm, mul_left_comm, mul_assoc, Finset.sum_add_distrib,
    Finset.sum_sub_distrib]; ring_nf
  norm_num [← Finset.mul_sum _ _ _, ← Finset.sum_mul, ← Finset.sum_comm]; ring_nf
  simp +decide only [mul_assoc, mul_left_comm]; ring

/-- Dagger cube closure: `Zdag * Z * Zdag = budget * Zdag`, obtained by taking
the conjugate transpose of `areaMatrix_cube` and using `budget_star`. -/
theorem areaMatrixH_cube (u v : Fin n → ℂ) :
    (areaMatrix u v)ᴴ * areaMatrix u v * (areaMatrix u v)ᴴ
      = budget u v • (areaMatrix u v)ᴴ := by
  convert congr_arg Matrix.conjTranspose (areaMatrix_cube u v) using 1; simp +decide [Matrix.mul_assoc]
  ext i j; simp +decide [budget, areaMatrix]; ring_nf
  simp +decide [mul_comm]

/-- The generalized rest operator: odd Hermitian block form. -/
def restOp (u v : Fin n → ℂ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℂ :=
  Matrix.fromBlocks 0 (areaMatrix u v) (areaMatrix u v)ᴴ 0

/-- `B^2` is block-diagonal: `fromBlocks (Z Zdag) 0 0 (Zdag Z)`. -/
theorem restOp_sq_block (u v : Fin n → ℂ) :
    restOp u v ^ 2
      = Matrix.fromBlocks (areaMatrix u v * (areaMatrix u v)ᴴ) 0 0
          ((areaMatrix u v)ᴴ * areaMatrix u v) := by
  rw [sq, restOp, Matrix.fromBlocks_multiply]; norm_num

/-- T3a: the rest operator is Hermitian. -/
theorem restOp_isHermitian (u v : Fin n → ℂ) : (restOp u v).IsHermitian := by
  unfold restOp; simp +decide [Matrix.IsHermitian, Matrix.conjTranspose]
  ext i j; aesop

/-- T3b: the rest operator is odd for the block grading. -/
theorem restOp_odd (u v : Fin n → ℂ) :
    Matrix.fromBlocks (1 : Matrix (Fin n) (Fin n) ℂ) 0 0 (-1) * restOp u v
      = -(restOp u v * Matrix.fromBlocks (1 : Matrix (Fin n) (Fin n) ℂ) 0 0 (-1)) := by
  ext i j; simp +decide [restOp]
  rcases i with (i | i) <;> rcases j with (j | j) <;> norm_num [Matrix.mul_apply]
  · simp +decide [Matrix.one_apply, Finset.sum_ite_eq]
  · simp +decide [Matrix.one_apply, mul_comm]

/-- T4 (the cube law): `B^3 = budget * B` - the same finite closure as the
interaction generator `K^3 = |z|^2 K`. -/
theorem restOp_cube (u v : Fin n → ℂ) :
    restOp u v ^ 3 = budget u v • restOp u v := by
  simp_all +decide [restOp, pow_succ, mul_assoc]
  simp_all +decide [← Matrix.mul_assoc, fromBlocks_multiply]
  rw [areaMatrix_cube, areaMatrixH_cube]; ext i j; aesop

/-- T5 (rank-4 support): when the budget is nonzero,
`P = budget^{-1} * B^2` is idempotent with trace 4 - the rest gap lives on
an exactly four-dimensional subspace for EVERY `n`. -/
theorem restOp_support_projector (u v : Fin n → ℂ) (h : budget u v ≠ 0) :
    ((budget u v)⁻¹ • restOp u v ^ 2) * ((budget u v)⁻¹ • restOp u v ^ 2)
        = (budget u v)⁻¹ • restOp u v ^ 2
      ∧ ((budget u v)⁻¹ • restOp u v ^ 2).trace = 4 := by
  constructor
  · -- Idempotency of `P = budget⁻¹ • B²`, using `B⁴ = budget • B²`.
    have hP_sq : (budget u v)⁻¹ • restOp u v ^ 2 * (budget u v)⁻¹ • restOp u v ^ 2
        = (budget u v)⁻¹ • restOp u v ^ 2 := by
      have hP : restOp u v ^ 3 = budget u v • restOp u v := restOp_cube u v
      simp_all +decide [pow_succ, mul_assoc, smul_smul]
    exact hP_sq
  · rw [Matrix.trace_smul, restOp_sq_block]
    simp +decide [Matrix.trace, Matrix.mul_apply, Matrix.conjTranspose_apply, mul_comm]
    have := sum_sq_areaMatrix u v
    rw [inv_mul_eq_div, div_eq_iff h]; simp_all +decide [mul_comm]
    rw [Finset.sum_comm]; linear_combination' this

/-- T6 (two-spinor recovery): at `n = 2` the support is everything -
`B^2 = budget * 1`, the landed Paper-A law. -/
theorem restOp_sq_two (u v : Fin 2 → ℂ) :
    restOp u v ^ 2 = budget u v • (1 : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) ℂ) := by
  convert restOp_sq_block u v using 1
  ext i j; fin_cases i <;> fin_cases j <;> simp +decide [Matrix.mul_apply, budget, areaMatrix] <;> ring!

/-- T7 (massless boundary): the area matrix vanishes iff the budget does. -/
theorem areaMatrix_eq_zero_iff (u v : Fin n → ℂ) :
    areaMatrix u v = 0 ↔ budget u v = 0 := by
  constructor <;> intro h <;> have := sum_sq_areaMatrix u v <;> simp_all +decide [Complex.ext_iff]
  rw [Finset.sum_eq_zero_iff_of_nonneg fun i _ => Finset.sum_nonneg fun j _ => by nlinarith] at this
  ext i j; simp_all +decide [Finset.sum_eq_zero_iff_of_nonneg, add_nonneg, mul_self_nonneg]
  exact Complex.ext (by norm_num; nlinarith only [this.1 i j]) (by norm_num; nlinarith only [this.1 i j])

/-- The non-decomposable control: two disjoint blocks - antisymmetric,
but NOT the area matrix of any spinor family. -/
def controlZ : Matrix (Fin 4) (Fin 4) ℂ := Matrix.of fun i j =>
  if (i, j) = (0, 1) ∨ (i, j) = (2, 3) then 1
  else if (i, j) = (1, 0) ∨ (i, j) = (3, 2) then -1
  else 0

/-- T8 (load-bearing hypothesis): `controlZ` has total squared area
`2 * 2`, but violates the cube law - so the cube closure is a theorem
about spinor-generated area data, not antisymmetric matrices in general.
Witness entry `(0,1)`: `(Z0 Z0dag Z0) 0 1 = 1` while `2 * Z0 0 1 = 2`. -/
theorem controlZ_violates_cube :
    (∑ i, ∑ j, star (controlZ i j) * controlZ i j = 2 * 2)
      ∧ (controlZ * controlZᴴ * controlZ) 0 1 = 1
      ∧ (2 : ℂ) • controlZ 0 1 = 2 := by
  unfold controlZ; norm_num [Fin.sum_univ_succ, Matrix.mul_apply]
  grind +extAll

end PhysicsSM.Draft.NullEdge.PlueckerRestOperatorGeneral
